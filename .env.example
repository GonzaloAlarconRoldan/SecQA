# Copy to .env (git-ignored). Every variable is optional.

# Require `Authorization: Bearer <token>` on the API. Strongly recommended for any shared Hub.
#   generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECQA_API_TOKEN=

# Default: SQLite at $SECQA_DATA_DIR/secqa.db. For Postgres:
# SECQA_DATABASE_URL=postgresql+psycopg://secqa:secret@db:5432/secqa

# Days to fix a defect before it breaches SLA
SECQA_SLA_CRITICAL_DAYS=7
SECQA_SLA_HIGH_DAYS=30
SECQA_SLA_MEDIUM_DAYS=90
SECQA_SLA_LOW_DAYS=180

# Performance degradation vs. baseline that counts as a regression (0.10 = 10 %)
SECQA_PERF_REGRESSION_TOLERANCE=0.10

# Only needed if the UI is served from a different origin (e.g. Vite dev server)
# SECQA_CORS_ORIGINS=["http://localhost:5173"]
