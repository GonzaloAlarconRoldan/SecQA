# SecQA — alcance autorizado para esta ejecución.
# Copia este archivo como scope.yml en la raíz del proyecto objetivo y edítalo
# ANTES de correr cualquier fase activa (pentest-api con pruebas dinámicas, pentest-dast).
# El framework debe negarse a probar cualquier objetivo que no esté listado aquí.

project_name: "nombre-del-proyecto"

# Hosts/puertos donde SÍ está autorizado correr pruebas activas (DAST, API dinámico).
# Solo localhost / contenedores propios. Nunca dominios públicos ni producción.
allowed_targets:
  - host: "127.0.0.1"
    ports: [3000, 8000]
    note: "entorno local levantado con docker-compose"

# Rutas del repo excluidas de SAST/SCA (ej. vendor, código generado)
exclude_paths:
  - "node_modules/"
  - "dist/"
  - "vendor/"

# Nivel de agresividad permitido para pruebas dinámicas.
# passive  = solo observación, sin enviar payloads
# active-safe = payloads no destructivos (lo único permitido por defecto)
# active-aggressive = requiere confirmación explícita adicional por el usuario en cada corrida
dast_aggressiveness: "active-safe"

# Confirmación explícita requerida para habilitar las fases activas.
authorized_by: ""        # nombre de quien autoriza
authorized_at: ""        # fecha ISO
